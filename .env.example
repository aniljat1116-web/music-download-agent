# Server Network Configuration
PORT=5000
HOST=0.0.0.0

# Optional API Security Key
# If set, clients must pass this via 'x-api-key' header or 'Authorization: Bearer <key>'
# API_KEY=your_secure_api_token_here

# Concurrency & Queue Configuration
MAX_CONCURRENT_JOBS=1
JOB_TTL_MS=3600000

# Browser Executable Path Override (Linux container default: /usr/bin/chromium)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# File Storage Directory (Default: ./downloads)
# DOWNLOADS_DIR=/app/downloads
